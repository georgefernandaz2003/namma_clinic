# Namma Clinic Frontend Configuration
#
# Production / Staging API Base URL (must end with a trailing slash):
# Example for staging: VITE_API_BASE_URL=https://staging.nammaclinic.karnataka.gov.in/api/
# Example for production: VITE_API_BASE_URL=https://nammaclinic.karnataka.gov.in/api/
#
# If left unset, Vite defaults to local development backend: http://localhost:8000/api/
VITE_API_BASE_URL=http://localhost:8000/api/
